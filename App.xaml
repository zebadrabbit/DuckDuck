<Application x:Class="DuckDuck.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown"
             ThemeMode="Dark">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#111214"/>
        <SolidColorBrush x:Key="Panel" Color="#1A1B1E"/>
        <SolidColorBrush x:Key="Text" Color="#E8E8E8"/>
        <SolidColorBrush x:Key="Muted" Color="#8B9099"/>
        <SolidColorBrush x:Key="Amber" Color="#F5A623"/>
        <SolidColorBrush x:Key="Blue" Color="#3DA9FC"/>
        <SolidColorBrush x:Key="BlueDim" Color="#2A6A9C"/>
        <SolidColorBrush x:Key="Track" Color="#2A2C31"/>
        <FontFamily x:Key="Glyph">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <FontFamily x:Key="Mono">JetBrains Mono, Cascadia Mono, Consolas</FontFamily>

        <Style x:Key="Flat" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- numbers that change: ms, %, levels. Mono so they don't jitter while ramping -->
        <Style x:Key="Readout" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Application.Resources>
</Application>
